<style>
/* Layout: barra del documento, nastro a schede, scrivania con il foglio al centro, barra di stato in basso. */
:root{
  --desk:#e3e6e4; --chrome:#f7f8f7; --chrome-2:#eef0ee; --line:#d3d8d5; --fg:#1f2523; --muted:#5e6964;
  --accent:#2f6b4f; --accent-soft:#dcebe2; --accent-fg:#fff; --danger:#a63d2f;
  --paper:#ffffff; --ink:#1a1a1a;
  --ui:"IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --brand:"Fraunces", Georgia, serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --desk:#15191a; --chrome:#1f2526; --chrome-2:#272e2f; --line:#364042; --fg:#e4ebe8; --muted:#9aa8a3;
  --accent:#6fbf96; --accent-soft:#24392f; --accent-fg:#0d1a14; --danger:#e07a6b; color-scheme:dark}}
:root[data-theme="dark"]{
  --desk:#15191a; --chrome:#1f2526; --chrome-2:#272e2f; --line:#364042; --fg:#e4ebe8; --muted:#9aa8a3;
  --accent:#6fbf96; --accent-soft:#24392f; --accent-fg:#0d1a14; --danger:#e07a6b; color-scheme:dark}
[hidden]{display:none!important}
html,body{height:100%}
body{background:var(--desk);color:var(--fg);font-family:var(--ui);font-size:13px;display:flex;flex-direction:column;overflow:hidden}
button,select,input{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:1px}

/* barra superiore */
.top{display:flex;align-items:center;gap:12px;background:var(--chrome);border-bottom:1px solid var(--line);
  padding-block:8px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));flex-wrap:wrap}
.brand{font-family:var(--brand);font-size:19px;font-weight:600;color:var(--accent);letter-spacing:.2px}
#docName{border:1px solid transparent;background:transparent;border-radius:6px;padding:4px 8px;min-width:0;width:260px;max-width:50vw;font-weight:500}
#docName:hover,#docName:focus{border-color:var(--line);background:var(--chrome-2)}
.saveState{color:var(--muted);font-size:12px}
.spacer{flex:1}
.btn{border:1px solid var(--line);background:var(--chrome-2);border-radius:6px;padding:5px 10px;white-space:nowrap}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);color:var(--accent-fg);border-color:var(--accent)}

/* schede e nastro */
.tabs{display:flex;gap:2px;background:var(--chrome);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));overflow-x:auto}
.tab{border:0;background:transparent;padding:7px 14px;border-bottom:2px solid transparent;color:var(--muted);font-weight:500}
.tab[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--accent)}
.ribbonWrap{background:var(--chrome);border-bottom:1px solid var(--line);overflow-x:auto}
.ribbon{display:flex;gap:0;align-items:stretch;padding-block:6px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));width:max-content}
.panel[hidden]{display:none!important}
.panel{display:flex;align-items:stretch}
.grp{display:flex;flex-direction:column;justify-content:space-between;gap:4px;padding:0 12px;border-right:1px solid var(--line)}
.grp:last-child{border-right:0}
.grp .row{display:flex;gap:3px;align-items:center}
.grp .lbl{font-size:10.5px;color:var(--muted);text-align:center;text-transform:uppercase;letter-spacing:.6px}
.ib{border:1px solid transparent;background:transparent;border-radius:5px;min-width:28px;height:28px;padding:0 6px;display:inline-flex;align-items:center;justify-content:center;gap:4px}
.ib:hover{background:var(--chrome-2);border-color:var(--line)}
.ib.on{background:var(--accent-soft);border-color:var(--accent)}
.ib svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.ib.big{flex-direction:column;height:auto;padding:4px 8px;font-size:11.5px;min-width:56px}
.ib.big svg{width:22px;height:22px}
select.sel{height:28px;border:1px solid var(--line);border-radius:5px;background:var(--paper);color:var(--ink);padding:0 4px}
.colorBtn{position:relative}
.colorBtn input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.swatch{display:block;width:16px;height:4px;border-radius:1px;margin-top:-2px}

/* scrivania e foglio */
.desk{flex:1;overflow:auto;background:var(--desk);position:relative;padding-block:28px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.zoomBox{width:max-content;margin:0 auto;display:flex;gap:16px;align-items:flex-start}
.paper{box-sizing:border-box;background:var(--paper);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.18),0 8px 28px rgba(0,0,0,.08);position:relative;
  font-family:Calibri,Carlito,Arial,sans-serif;font-size:11pt;line-height:1.15}
.hf{position:absolute;left:0;right:0;font-size:9pt;color:#555;min-height:1.2em;outline:none;border:1px dashed transparent}
.hf:hover,.hf:focus{border-color:#b9c3bf}
.hf:empty::before{content:attr(data-ph);color:#aab}
#editor{outline:none;min-height:100%;position:relative}
.doc p{margin:0 0 8pt}
.doc h1{font-size:20pt;font-weight:700;color:#1f3a5f;margin:12pt 0 6pt}
.doc h2{font-size:15pt;font-weight:700;color:#1f3a5f;margin:10pt 0 4pt}
.doc h3{font-size:12.5pt;font-weight:700;color:#2b4a6f;margin:8pt 0 4pt}
.doc h4{font-size:11pt;font-weight:600;font-style:italic;color:#4a5560;margin:6pt 0 4pt}
.doc blockquote{margin:6pt 0 8pt 0;padding-left:12pt;border-left:3px solid #9bb;color:#444;font-style:italic}
.doc pre{font-family:"Courier New",monospace;font-size:10pt;background:#f4f4f4;padding:6pt;margin:0 0 8pt;white-space:pre-wrap}
.doc ul,.doc ol{margin:0 0 8pt;padding-left:24pt}
.doc li{margin:0 0 2pt}
.doc table{border-collapse:collapse;width:100%;margin:0 0 8pt}
.doc td,.doc th{border:1px solid #888;padding:4pt 6pt;vertical-align:top;min-width:30px}
.doc td p,.doc th p{margin:0}
.doc img{max-width:100%;height:auto;cursor:pointer}
.doc img.selImg{outline:2px solid var(--accent)}
.doc a{color:#1a56a8}
.doc hr{border:0;border-top:1px solid #999;margin:8pt 0}
.doc .pb{height:0;border-top:1px dashed #9aa;margin:14pt 0;position:relative;user-select:none}
.doc .pb::after{content:"Interruzione di pagina";position:absolute;left:50%;top:-8px;transform:translateX(-50%);background:#fff;color:#8a9;font:10px var(--ui);padding:0 6px}
.fld{background:#e8efeb;border-radius:2px;padding:0 2px}
.pageGuides{position:absolute;left:0;right:0;pointer-events:none}
.pageGuide{position:absolute;left:-14px;right:-14px;border-top:1px dashed #c6cfcb}
.pageGuide span{position:absolute;right:0;top:2px;font:10px var(--ui);color:#9aa8a3;background:var(--paper);padding:0 4px}

/* barra di stato */
.status{display:flex;align-items:center;gap:16px;background:var(--chrome);border-top:1px solid var(--line);color:var(--muted);font-size:12px;
  padding-block:5px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-bottom:max(5px,env(safe-area-inset-bottom,0px));font-variant-numeric:tabular-nums;flex-wrap:wrap}
.status input[type=range]{width:110px;accent-color:var(--accent)}

/* trova e sostituisci */
.findBar{display:flex;gap:6px;align-items:center;flex-wrap:wrap;background:var(--chrome-2);border-bottom:1px solid var(--line);
  padding-block:6px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.findBar input[type=text]{border:1px solid var(--line);border-radius:5px;padding:4px 8px;background:var(--chrome);width:180px;max-width:40vw}
.findMsg{color:var(--muted);font-size:12px}

/* finestre */
.modalBack{position:fixed;inset:0;background:rgba(10,20,15,.35);display:flex;align-items:center;justify-content:center;z-index:50;padding:16px}
.modal{background:var(--chrome);border:1px solid var(--line);border-radius:10px;box-shadow:0 12px 40px rgba(0,0,0,.25);width:min(440px,100%);max-height:90vh;overflow:auto}
.modal h3{margin:0;padding:14px 18px 6px;font-size:15px}
.modal .body{padding:8px 18px;display:flex;flex-direction:column;gap:10px}
.modal label{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted)}
.modal input[type=text],.modal input[type=url],.modal input[type=number],.modal select{border:1px solid var(--line);border-radius:5px;padding:6px 8px;background:var(--chrome-2);color:var(--fg)}
.modal .foot{display:flex;justify-content:flex-end;gap:8px;padding:12px 18px 16px}
.stats{display:grid;grid-template-columns:1fr auto;gap:6px 18px;font-variant-numeric:tabular-nums}
.symGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(34px,1fr));gap:4px}
.symGrid button{height:34px;border:1px solid var(--line);background:var(--chrome-2);border-radius:5px;font-size:16px}
.tblGrid{display:grid;grid-template-columns:repeat(8,22px);gap:3px}
.tblGrid div{width:22px;height:22px;border:1px solid var(--line);background:var(--chrome-2);border-radius:2px;cursor:pointer}
.tblGrid div.hl{background:var(--accent-soft);border-color:var(--accent)}
.pop{position:fixed;z-index:40;background:var(--chrome);border:1px solid var(--line);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.2);padding:10px}
.imgBar{position:fixed;z-index:30;display:flex;gap:2px;background:var(--chrome);border:1px solid var(--line);border-radius:7px;padding:3px;box-shadow:0 4px 14px rgba(0,0,0,.18)}
.toast{position:fixed;left:50%;bottom:48px;transform:translateX(-50%);background:var(--fg);color:var(--desk);padding:8px 14px;border-radius:6px;z-index:60;font-size:12.5px;max-width:90vw}

/* v2 */
.doc ins{color:#17663a;text-decoration:underline;text-decoration-color:#17663a}
.doc del{color:#b3261e;text-decoration:line-through}
.doc.final del{display:none}.doc.final ins{color:inherit;text-decoration:none}
.doc .cmt{background:#fff1b8;border-bottom:2px solid #e0b400}.doc .cmt.on{background:#ffd966}
.doc.noCmt .cmt,.pgBody .cmt{background:none;border:0}
.doc sup.fn{color:#1a56a8;cursor:pointer;font-size:.72em;padding:0 1px}
.doc .tab{white-space:pre;tab-size:4}
.doc .eq{display:inline-block;vertical-align:middle;cursor:pointer;padding:0 2px}.doc .eq svg{vertical-align:middle}
.doc .mf{background:#e3ecf7;border-radius:3px;padding:0 3px;color:#1a3f6b}.doc .mf.val{background:#eef6e3;color:inherit}.pgBody .mf{background:none;padding:0;color:inherit}
.doc .toc{border:1px dashed #c7d0cc;padding:8pt 10pt;margin:0 0 12pt;cursor:default;user-select:none}
.doc .tocTitle{font-weight:700;font-size:14pt;margin-bottom:6pt}
.doc .tocRow{display:flex;align-items:baseline;gap:4px;cursor:pointer;margin:2pt 0}.doc .tocRow:hover .tt{text-decoration:underline}
.doc .tocRow.l1{font-weight:600}.doc .tocRow.l2{padding-left:14pt}.doc .tocRow.l3{padding-left:28pt}
.doc .tocRow .dots{flex:1;border-bottom:1px dotted #888;transform:translateY(-3px)}.doc .tocEmpty{color:#888;font-style:italic}
.pgBody .toc{border:0;padding:0}
.notesBox{margin-top:18pt;padding-top:4pt;font-size:9pt;position:relative}
.notesBox::before{content:"";position:absolute;top:0;left:0;width:35%;border-top:1px solid #999}
.notesBox p,.pgNotes p{margin:0 0 2pt;font-size:9pt;line-height:1.2}
.notesBox p{cursor:pointer}.notesBox p:hover{background:#f3f6f4}
.wm{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-40deg);font:700 88px Calibri,Carlito,Arial,sans-serif;color:rgba(0,0,0,.07);white-space:nowrap;pointer-events:none;user-select:none;z-index:0}
.pgHost{position:absolute;left:0;top:0;z-index:-5;pointer-events:none}
.pg{position:relative;overflow:hidden;box-sizing:border-box;color:#1a1a1a}
.pgInner{position:absolute;display:flex;flex-direction:column;justify-content:space-between}
.pgBody{display:flow-root}
.pgNotes:not(:empty){border-top:1px solid #999;padding-top:3pt;width:100%}
.pgNotes p{width:auto}
.pgHF{position:absolute;font-size:9pt;color:#555;font-family:Calibri,Carlito,Arial,sans-serif}.pgHF p{margin:0}
.preview{display:flex;flex-direction:column;align-items:center;gap:20px;padding-bottom:30px}
.preview .pg{box-shadow:0 1px 3px rgba(0,0,0,.18),0 8px 28px rgba(0,0,0,.08)}
.pvBar{position:sticky;top:0;z-index:5;display:flex;gap:8px;align-items:center;justify-content:center;flex-wrap:wrap;margin:-28px 0 20px;padding:8px;background:var(--chrome);border-bottom:1px solid var(--line)}
.cmtPane{width:250px;flex:none;display:flex;flex-direction:column;gap:8px}
.cmtCard{background:var(--chrome);border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:12.5px;cursor:pointer;display:flex;flex-direction:column;gap:4px}
.cmtCard.on{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}
.cmtMeta{color:var(--muted);font-size:11.5px}.cmtMeta b{color:var(--fg)}
.cmtQuote{color:var(--muted);font-style:italic;font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cmtText{white-space:pre-wrap}.cmtReply{border-left:2px solid var(--line);padding-left:6px}
.cmtActs{display:flex;gap:4px;justify-content:flex-end}.cmtActs .ib{height:24px;font-size:11.5px}
.eqPrev{min-height:50px;display:flex;align-items:center;justify-content:center;background:#fff;color:#000;border:1px solid var(--line);border-radius:6px;padding:8px;overflow-x:auto}
.eqBtns{display:flex;flex-wrap:wrap;gap:3px}.eqBtns .ib{border-color:var(--line);height:26px}
.hint{font-size:12px;color:var(--muted)}
.modal textarea{border:1px solid var(--line);border-radius:5px;padding:6px 8px;background:var(--chrome-2);color:var(--fg);font:inherit;resize:vertical;width:100%;box-sizing:border-box}
.modal{width:min(520px,100%)}
.dictLive{position:fixed;left:50%;bottom:44px;transform:translateX(-50%);background:var(--accent-soft);color:var(--fg);border:1px solid var(--accent);border-radius:16px;padding:6px 14px;z-index:45;max-width:80vw;font-size:13px}
.trackOn{color:var(--danger);font-weight:600}
.ribbon select.sel.small{height:26px}
.doc .shape{display:inline-block;vertical-align:middle;cursor:pointer;line-height:0}
.doc .chart{display:inline-block;cursor:pointer;line-height:0;max-width:100%}.doc .chart svg{max-width:100%;height:auto}
.doc .tbox{box-sizing:border-box;position:relative;z-index:1}.doc .tbox p{margin:0 0 4pt}.doc .tbox p:last-child{margin-bottom:0}
.doc p.caption{font-style:italic;font-size:9pt;color:#44546a;margin-top:2pt}
.doc .bm{display:inline-block;width:7px;height:11px;margin:0 1px;vertical-align:baseline;background:linear-gradient(135deg,#2f6b4f 50%,transparent 50%);opacity:.75}
.pgBody .bm{display:none}
.doc p.dropcap::first-letter{float:left;font-size:3.3em;line-height:.82;padding:3pt 5pt 0 0;font-weight:700;color:inherit}
.chGrid{border-collapse:collapse}.chGrid td,.chGrid th{padding:2px}.chGrid th{font-size:11px;color:var(--muted);text-align:left}.chGrid input{width:86px;border:1px solid var(--line);border-radius:4px;padding:3px 5px;background:var(--chrome-2);color:var(--fg)}

/* vista a pagine separate */
#sheets{position:absolute;inset:0;pointer-events:none;z-index:0}
#sheets .sheet{position:absolute;left:0;right:0;background:var(--paper);box-shadow:0 1px 3px rgba(0,0,0,.18),0 6px 20px rgba(0,0,0,.08);overflow:hidden;pointer-events:auto}
#sheets .sheetHF{opacity:.55}
.paper.pagesView{background:transparent!important;box-shadow:none!important}
.paper.pagesView #editor,.paper.pagesView .hf,.paper.pagesView #notesBox{z-index:1}
.paper.pagesView .hf{z-index:2}
.paper.pagesView .hf:not(:focus){opacity:.72}
.hf.firstOff:not(:focus){opacity:.3}.paper.pagesView .hf.firstOff:not(:focus){opacity:.3}.hf.firstAlt:not(:focus),.paper.pagesView .hf.firstAlt:not(:focus){opacity:0}body:has(#hdr:focus) .firstCloneH,body:has(#ftr:focus) .firstCloneF{visibility:hidden}.hfAltBox{box-sizing:border-box;width:100%;border:1px dashed var(--line);border-radius:4px;min-height:30px;padding:4px 8px;background:#fff;color:#000;font-size:13px}.hfAltBox p{margin:0}.modal label.hfAltLab{display:flex;flex-direction:row;gap:6px;align-items:center;font-weight:600;margin-top:6px}
.doc .pgSp{display:block;list-style:none;margin:0!important;padding:0!important;border:0!important;user-select:none;pointer-events:none;counter-increment:none}
.doc tr.pgSp{display:table-row}
.paper.pagesView .doc .pb{border-top-color:transparent;margin:0}
.paper.pagesView .doc .pb::after{display:none}
body.marks .paper.pagesView .doc .pb{border-top-color:#9aa}body.marks .paper.pagesView .doc .pb::after{display:block}
.pgBorder{position:absolute;pointer-events:none;box-sizing:border-box}
body.webView .paper{width:auto!important;min-width:0;max-width:none;flex:1}
body.webView .zoomBox{width:auto;display:flex}body.webView #hdr,body.webView #ftr,body.webView .hfLabel{display:none!important}body.webView .doc{margin-top:0!important}

/* aspetto del nastro simile ai programmi di videoscrittura */
.top{padding-block:5px;gap:10px}
.qat{display:flex;gap:1px}.qat .ib{height:26px;min-width:26px}
.cmdSearch{position:relative;display:flex;align-items:center;gap:6px;background:var(--chrome-2);border:1px solid var(--line);border-radius:6px;padding:0 8px;width:min(380px,40vw);height:28px}
.cmdSearch svg{width:14px;height:14px;fill:none;stroke:var(--muted);stroke-width:2;flex:none}
.cmdSearch input{border:0;background:transparent;outline:none;width:100%;height:26px}
.cmdRes{position:absolute;left:-1px;right:-1px;top:30px;background:var(--chrome);border:1px solid var(--line);border-radius:6px;box-shadow:0 10px 28px rgba(0,0,0,.18);z-index:50;max-height:60vh;overflow:auto;padding:4px}
.cmdRes button{display:flex;width:100%;text-align:left;border:0;background:transparent;padding:6px 8px;border-radius:5px;gap:8px;align-items:baseline}
.cmdRes button small{color:var(--muted);margin-left:auto;font-size:11px}
.cmdRes button.hl,.cmdRes button:hover{background:var(--accent-soft)}
.tab{padding:6px 12px;font-size:13px}
.tab.fileTab{color:var(--accent);font-weight:600}
.tab.ctxTab{color:var(--accent);background:var(--accent-soft);border-radius:6px 6px 0 0}
.grp{padding:0 10px;gap:2px;position:relative}
.grp .lbl{text-transform:none;letter-spacing:0;font-size:11px;padding-right:14px;position:relative;margin-top:2px}
.launch{position:absolute;right:-6px;bottom:0;width:14px;height:14px;border:0;background:transparent;padding:0;border-radius:3px}
.launch::before{content:"";position:absolute;right:3px;bottom:3px;width:6px;height:6px;border-right:1.5px solid var(--muted);border-bottom:1.5px solid var(--muted)}
.launch::after{content:"";position:absolute;right:3px;bottom:3px;width:8px;height:1.5px;background:var(--muted);transform:rotate(45deg);transform-origin:right bottom}
.launch:hover{background:var(--chrome-2)}
.grp .col{display:flex;flex-direction:column;gap:1px;justify-content:center}
.grp .col .ib{justify-content:flex-start;height:25px;font-size:12px}
.ib.big{min-height:62px;justify-content:flex-start}
