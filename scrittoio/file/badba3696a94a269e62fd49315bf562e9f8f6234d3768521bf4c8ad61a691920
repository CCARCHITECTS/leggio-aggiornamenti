async function runMacro(m){restoreSel();ed.focus();for(const s of m.steps){try{
  if(s.k==='act'){const f=ACTS[s.v];if(f)await f();}else if(s.k==='cmd'){const b=document.querySelector('[data-cmd="'+s.v+'"]');if(b)b.click();else document.execCommand(s.v,false,s.arg);}
