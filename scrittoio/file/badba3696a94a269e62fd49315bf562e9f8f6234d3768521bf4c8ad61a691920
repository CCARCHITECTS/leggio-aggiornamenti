        s+='<circle cx="'+x+'" cy="'+y+'" r="'+r+'" fill="'+shade(C,i*0.1)+'"/>'+txtBlock(x,y,it.t,10,12,'#fff');});break;}
    case 'hier':{const lv=[];items.forEach(it=>{(lv[it.l]=lv[it.l]||[]).push(it);});const rows=lv.length,rh=H/rows;const pos=[];
      lv.forEach((row,ri)=>{const bw=Math.min(140,(W-10*(row.length-1))/row.length),bh=Math.min(54,rh-22);const tot=row.length*bw+(row.length-1)*10;row.forEach((it,i)=>{const x=(W-tot)/2+i*(bw+10),y=ri*rh+(rh-bh)/2;it._x=x+bw/2;it._y=y;it._b=y+bh;
        s+='<rect x="'+x+'" y="'+y+'" width="'+bw+'" height="'+bh+'" rx="6" fill="'+shade(C,ri*0.18)+'"/>'+txtBlock(x+bw/2,y+bh/2,it.t,Math.max(8,bw/7.5),12,'#fff');});});
      let par=[];const lines=[];items.forEach(it=>{par[it.l]=it;if(it.l>0&&par[it.l-1]){const p=par[it.l-1];const my=(p._b+it._y)/2;lines.push('<path d="M'+p._x+','+p._b+' V'+my+' H'+it._x+' V'+it._y+'" fill="none" stroke="'+shade(C,0.35)+'" stroke-width="1.5"/>');}});s=lines.join('')+s;break;}
