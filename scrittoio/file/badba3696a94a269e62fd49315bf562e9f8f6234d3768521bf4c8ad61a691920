    if(force){startNew(c,top,'DIV');force=false;top=yIn(c);}
    else if(top+h>pageStart+ch+0.5&&top>pageStart+2){
      const splittable=/^(TABLE|UL|OL)$/.test(c.tagName)&&h>ch*0.35;const textual=/^(P|H[1-6]|BLOCKQUOTE|PRE|DIV)$/.test(c.tagName)&&!c.querySelector('table,img,svg,ul,ol,p,div')&&!/^H/.test(c.tagName)&&!(c.dataset.kl==='1'&&h<=ch);
      if(textual&&top<pageStart+ch-8&&splitBlock(c,pageStart+ch,(page+1)*P)){page++;pageStart=page*P;}
      else if(!splittable||top>=pageStart+ch-8){startNew(c,top,'DIV');top=yIn(c);}
    }
    // blocco troppo alto: lo divido per righe (tabelle ed elenchi) o lo lascio scorrere
    let guard=0;
    while(yIn(c)+hIn(c)>pageStart+ch+0.5&&guard++<200){
      if(/^(TABLE|UL|OL)$/.test(c.tagName)){
        const rows=c.tagName==='TABLE'?Array.from(c.rows).filter(r=>!r.classList.contains('pgSp')):Array.from(c.children).filter(x=>x.tagName==='LI'&&!x.classList.contains('pgSp'));
        const cols=c.tagName==='TABLE'?Math.max(1,...rows.map(r=>Array.from(r.cells).reduce((a,x)=>a+(x.colSpan||1),0))):1;
        const r=rows.find(x=>yIn(x)+hIn(x)>pageStart+ch+0.5);
        if(!r||yIn(r)<=pageStart+2){const bottom=yIn(c)+hIn(c);page=Math.max(page,Math.floor(bottom/P));pageStart=page*P;break;}
        startNew(r,yIn(r),r.tagName,cols);
      }else if(/^(P|BLOCKQUOTE|PRE|DIV)$/.test(c.tagName)&&!c.querySelector('table,img,svg,ul,ol,p,div')&&splitBlock(c,pageStart+ch,(page+1)*P)){page++;pageStart=page*P;}
      else{const bottom=yIn(c)+hIn(c);page=Math.max(page,Math.floor((bottom-1)/P));pageStart=page*P;break;}
    }
  }
  if(force){page++;pageStart=page*P;}
  const notesH=$('#notesBox').hidden?0:$('#notesBox').offsetHeight+28;
  let n=page+1;const need=yIn(ed.lastElementChild||ed)+hIn(ed.lastElementChild||ed)+notesH;
  while(need>(n-1)*P+ch+0.5&&n<page+3)n++;
  viewPages=n;
  ed.style.minHeight=Math.max(ch,(n*P-GAP)-(m.t+m.b)*MM-notesH)+'px';paper.style.minHeight=(n*P-GAP)+'px';
  // fogli
  sheets.innerHTML='';const total=n;
  const hfClone=(src,i,pos)=>{if(!src.textContent.trim()&&!src.querySelector('img,.fld'))return null;const x=document.createElement('div');x.className='pgHF sheetHF';x.innerHTML=src.innerHTML;
    x.querySelectorAll('.fld').forEach(f=>f.textContent=f.dataset.f==='total'?total:pgNum(i));x.style.cssText='left:'+m.l*MM+'px;width:'+(W-(m.l+m.r)*MM)+'px;'+pos;return x;};
  const firstDiff=!!st.firstDiff;
  for(let i=0;i<n;i++){const s=document.createElement('div');s.className='sheet';s.style.cssText='top:'+(i*P)+'px;height:'+H+'px;background:'+(st.pageColor||'');
    if(st.pageBorder&&st.pageBorder.style&&st.pageBorder.style!=='none'){const b=document.createElement('div');b.className='pgBorder';b.style.cssText='inset:'+(st.pageBorder.off||10)+'mm;border:'+(st.pageBorder.w||1.5)+'px '+st.pageBorder.style+' '+(st.pageBorder.color||'#444');s.appendChild(b);}
    if(st.wm){const w=document.createElement('div');w.className='wm';w.textContent=st.wm;s.appendChild(w);}
    {const al=st.hfAlt||{};const ev=!!st.evenDiff&&i%2===1;const tp='top:'+Math.max(6,m.t*0.4)*MM+'px',bt='bottom:'+Math.max(6,m.b*0.4)*MM+'px';
      if(i>0){const a=hfClone(ev?hfEl(al.eh):hdr,i,tp);if(a)s.appendChild(a);const b=hfClone(ev?hfEl(al.ef):ftr,i,bt);if(b)s.appendChild(b);}
      else if(firstDiff){const a=al.fh&&hfClone(hfEl(al.fh),0,tp);if(a){a.classList.add('firstCloneH');s.appendChild(a);}const b=al.ff&&hfClone(hfEl(al.ff),0,bt);if(b){b.classList.add('firstCloneF');s.appendChild(b);}}}
    if(i>0)s.addEventListener('dblclick',e=>{const r=s.getBoundingClientRect();const k=s.offsetHeight/(r.height||1);const y=(e.clientY-r.top)*k;if(y<m.t*MM){hdr.focus();placeCaretEnd(hdr);}else if(y>H-m.b*MM){ftr.focus();placeCaretEnd(ftr);}});
    sheets.appendChild(s);}
  hdr.classList.toggle('firstOff',firstDiff);ftr.classList.toggle('firstOff',firstDiff);hdr.classList.toggle('firstAlt',firstDiff&&!!(st.hfAlt&&st.hfAlt.fh));ftr.classList.toggle('firstAlt',firstDiff&&!!(st.hfAlt&&st.hfAlt.ff));
  ftr.style.top=(H-Math.max(6,m.b*0.4)*MM-ftr.offsetHeight)+'px';
  $('#stPages').textContent=pageLabel();
  if(typeof drawRuler==='function')drawRuler();}
function caretPage(){if(!pageView||!lastRange||!ed.contains(lastRange.startContainer))return 1;let n=lastRange.startContainer;if(n.nodeType===3)n=n.parentNode;
  const P=pageDims().h*MM+GAP;try{const r=lastRange.getClientRects()[0]||n.getBoundingClientRect();const er=ed.getBoundingClientRect();const k=ed.offsetHeight/(er.height||1);return Math.min(viewPages,Math.max(1,Math.floor(((r.top-er.top)*k)/P)+1));}catch(e){return 1;}}
