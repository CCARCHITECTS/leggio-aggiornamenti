const hist=[];let hIdx=-1,hTimer=null;
function pathOf(node,root){const p=[];while(node&&node!==root){const par=node.parentNode;if(!par)return null;p.unshift(Array.prototype.indexOf.call(par.childNodes,node));node=par;}return node===root?p:null;}
function nodeAt(path,root){let n=root;for(const i of path){if(!n.childNodes[i])return null;n=n.childNodes[i];}return n;}
function snap(){const sp=detachSpacers();try{return snap0();}finally{reattachSpacers(sp);}}
function snap0(){const s=getSelection();let sel=null;
  if(s.rangeCount&&ed.contains(s.anchorNode)){const r=s.getRangeAt(0);sel={sp:pathOf(r.startContainer,ed),so:r.startOffset,ep:pathOf(r.endContainer,ed),eo:r.endOffset};}
  return {html:ed.innerHTML,sel};}
function record(){clearTimeout(hTimer);const s=snap();if(hIdx>=0&&hist[hIdx].html===s.html){hist[hIdx].sel=s.sel;return;}
  hist.splice(hIdx+1);hist.push(s);if(hist.length>200)hist.shift();hIdx=hist.length-1;markDirty();}
function recordSoon(){clearTimeout(hTimer);hTimer=setTimeout(record,450);}
function applySnap(s){ed.innerHTML=s.html;ed.focus({preventScroll:true});
  if(s.sel&&s.sel.sp){try{const r=document.createRange();const a=nodeAt(s.sel.sp,ed),b=nodeAt(s.sel.ep,ed);if(a&&b){r.setStart(a,Math.min(s.sel.so,len(a)));r.setEnd(b,Math.min(s.sel.eo,len(b)));const x=getSelection();x.removeAllRanges();x.addRange(r);}}catch(e){}}
  afterChange(false);}
function len(n){return n.nodeType===3?n.length:n.childNodes.length;}
function undo(){if(hTimer){record();}if(hIdx>0){hIdx--;applySnap(hist[hIdx]);}}
function redo(){if(hIdx<hist.length-1){hIdx++;applySnap(hist[hIdx]);}}
ed.addEventListener('input',()=>{recordSoon();afterChange(true);});
