      else{CLOUD.keys[id]=d.o;const n=htmlToNode(d.h);n.dataset.bid=id;insertByKey(n,d.o);CLOUD.sent[id]=blockHtml(n);changed=true;}}
    if(!topBlocks().length){ed.innerHTML='<p><br></p>';}
  }finally{if(changed)caretRestore(car);cloudObs.takeRecords();CLOUD.applying=false;}
  if(changed){afterChange();cloudState('Online');peersDraw();}}
function cloudApplyMeta(s){if(!s.exists){toast('Il documento online è stato eliminato');cloudLeave();return;}if(s.metadata&&s.metadata.hasPendingWrites)return;const d=s.data();
  const remote=JSON.stringify({name:d.name,h:d.h,f:d.f,c:d.c||{},p:d.p||{}});const local=cloudMeta();if(remote===CLOUD.metaSent||local!==CLOUD.metaSent)return;
