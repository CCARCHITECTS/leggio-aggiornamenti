const AGG_URLS=['https://raw.githubusercontent.com/CCARCHITECTS/scrittoio-aggiornamenti/main/','https://raw.githubusercontent.com/CCARCHITECTS/leggio-aggiornamenti/main/scrittoio/'];
const AGG={busy:false,skip:null,avvisato:null};
const aggB64=s=>{const b=atob(String(s).trim());const u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return u;};
const aggHex=u=>Array.from(u,x=>x.toString(16).padStart(2,'0')).join('');
const aggCmp=(a,b)=>{const x=String(a).split('.').map(n=>+n||0),y=String(b).split('.').map(n=>+n||0);for(let i=0;i<Math.max(x.length,y.length);i++){const p=x[i]||0,q=y[i]||0;if(p!==q)return p<q?-1:1;}return 0;};
async function aggManifesto(H){let err=null;
  for(const u of AGG_URLS){try{const m=await H.scarica(u+'manifest.json'),sg=await H.scarica(u+'manifest.sig');
      if(!self.nacl||!nacl.sign.detached.verify(m,aggB64(utf8(sg)),aggB64(AGG_PUB)))throw new Error('la firma dell\'aggiornamento non è valida');
      const j=JSON.parse(utf8(m));if(j.app!=='scrittoio')throw new Error('pacchetto non di Scrittoio');return {j,u};}
    catch(e){err=e;}}
  throw err||new Error('nessun indirizzo raggiungibile');}
async function aggCerca(manuale){const H=DESK&&DESK.aggiorna;
  if(!H){if(manuale)toast('La versione online di Scrittoio è sempre aggiornata');return;}
  if(AGG.busy){if(manuale)toast('Sto già controllando gli aggiornamenti…');return;}AGG.busy=true;
  try{const info=await H.info();const cur=info.attiva||info.base;if(manuale)toast('Controllo gli aggiornamenti…');
    let man;try{man=await aggManifesto(H);}catch(e){if(manuale)toast('Non riesco a controllare gli aggiornamenti: '+e.message);else{clearTimeout(AGG.riprova);AGG.riprova=setTimeout(()=>aggCerca(false),30*60*1000);}return;}
    const j=man.j;if(aggCmp(j.versione,cur)<=0){if(manuale)toast('Scrittoio è aggiornato (versione '+cur+')');return;}
    if((+j.motore||1)>(+info.motore||1)){if(manuale||AGG.avvisato!==j.versione){AGG.avvisato=j.versione;await modal('Nuova versione di Scrittoio',el('p',{style:'margin:0;line-height:1.5',text:'È uscita la versione '+j.versione+'. Questa volta serve installare il nuovo programma (chiedilo a chi ti ha dato Scrittoio): l\'aggiornamento automatico non basta.'}),[{t:'Chiudi',v:1,primary:true}]);}return;}
    const pl=DESK.android?'android':'pc';const lst=j[pl]&&j[pl].file;if(!lst){if(manuale)toast('Nessun aggiornamento per questo dispositivo');return;}
    if(!manuale&&AGG.skip===j.versione)return;
    // prima scarica e controlla tutto, poi chiede conferma prima di installare
    if(!AGG.pronto||AGG.pronto.v!==j.versione){if(manuale)toast('Scarico l\'aggiornamento…');const miss=await H.mancanti(lst);const files={};
      for(const k of miss){const b=await H.scarica(man.u+'file/'+lst[k]);if(aggHex(sha256(b))!==lst[k])throw new Error('il file '+k+' scaricato non corrisponde');files[k]=b;}
      AGG.pronto={v:j.versione,lst,files};}
    const r=await modal('Aggiornamento disponibile',el('div',{style:'line-height:1.5;display:flex;flex-direction:column;gap:6px'},[el('p',{style:'margin:0',text:'È pronta Scrittoio '+j.versione+' (ora hai la '+cur+'). Vuoi installarla?'}),j.note?el('p',{style:'margin:0',text:'Novità: '+j.note}):'',el('p',{class:'hint',style:'margin:0',text:'Sono solo le pagine del programma, firmate dallo studio e già controllate: nessun nuovo programma da installare. Scrittoio si riavvia e riprende il documento dalla bozza.'})]),[{t:'Più tardi',v:false},{t:'Installa e riavvia',v:true,primary:true}]);
    if(!r){AGG.skip=j.versione;return;}
    await H.installa(AGG.pronto.v,AGG.pronto.lst,AGG.pronto.files);AGG.pronto=null;
    try{saveDraft();}catch(e){}toast('Aggiornamento installato: riavvio…');await H.riavvia();}
  catch(e){if(manuale)toast('Aggiornamento non riuscito: '+(e&&e.message||e));else AGG.riprova=setTimeout(()=>aggCerca(false),30*60*1000);}
  finally{AGG.busy=false;}}
ACTS.aggiorna=()=>aggCerca(true);
if(DESK&&DESK.aggiorna){$$('.aggOnly').forEach(x=>x.hidden=false);
  setTimeout(async()=>{try{await DESK.aggiorna.ok();const i=await DESK.aggiorna.info();if(i&&i.scartata)toast('L\'aggiornamento '+i.scartata+' non partiva bene: Scrittoio è tornato alla versione '+(i.attiva||i.base));}catch(e){}},2500);
  setTimeout(()=>aggCerca(false),20000);setInterval(()=>aggCerca(false),4*3600*1000);}
/* ---------- scorciatoie ---------- */
document.addEventListener('keydown',e=>{const k=e.key.toLowerCase(),mod=e.ctrlKey||e.metaKey;if(!mod)return;
  if(k==='z'&&!e.shiftKey&&inEditor(document.activeElement)&&document.activeElement===ed){e.preventDefault();undo();}
  else if((k==='y'||(k==='z'&&e.shiftKey))&&document.activeElement===ed){e.preventDefault();redo();}
  else if(k==='s'){e.preventDefault();saveDocx(e.shiftKey);}
  else if(k==='o'){e.preventDefault();openAsk();}
  else if(k==='p'){e.preventDefault();if(DESK)deskPrint();else openPreview();}
  else if(k==='f'||k==='h'){e.preventDefault();openFind();}
  else if(k==='k'){e.preventDefault();linkDialog();}
  else if(k==='enter'&&document.activeElement===ed){e.preventDefault();ACTS.pagebreak();}
  else if((k==='b'||k==='i'||k==='u')&&document.activeElement===ed){setTimeout(()=>{record();updateUI();},0);}});
ed.addEventListener('keydown',e=>{if(e.key==='Tab'){e.preventDefault();const cell=currentCell();
  if(cell){const cells=Array.from(cell.closest('table').querySelectorAll('td,th'));const n=cells[cells.indexOf(cell)+(e.shiftKey?-1:1)];if(n){const r=document.createRange();r.selectNodeContents(n);const s=getSelection();s.removeAllRanges();s.addRange(r);}return;}
  const li=lastRange&&lastRange.startContainer.parentElement&&lastRange.startContainer.parentElement.closest('li');
  if(li)document.execCommand(e.shiftKey?'outdent':'indent');else document.execCommand('insertText',false,'\u2003');record();}});
ed.addEventListener('paste',e=>{if(track){e.preventDefault();insertTracked((e.clipboardData&&e.clipboardData.getData('text/plain'))||'');return;}const html=e.clipboardData&&e.clipboardData.getData('text/html');if(html){e.preventDefault();
  let clean=sanitize(html).replace(/<!--[\s\S]*?-->/g,'').replace(/ class="Mso[^"]*"/g,'');document.execCommand('insertHTML',false,clean);record();}});

$('#selShow').onchange=e=>{ed.classList.toggle('final',e.target.value==='final');};
/* ---------- schede ---------- */
$$('.tab').forEach(t=>t.addEventListener('click',()=>{$$('.tab').forEach(x=>x.setAttribute('aria-selected',x===t));$$('.panel').forEach(p=>p.hidden=p.dataset.panel!==t.dataset.tab);}));

/* ---------- avvio ---------- */
const SAMPLE=`<h1>Relazione di esempio</h1>
<h4>Questo è un documento di prova: cancellalo e scrivi il tuo, oppure apri un file Word con «Apri».</h4>
<p>Scrittoio funziona come un normale programma di videoscrittura. Puoi scrivere in <b>grassetto</b>, <i>corsivo</i>, <u>sottolineato</u>, <span style="color:#c0392b">a colori</span> e <span style="background-color:#ffeb3b">evidenziato</span>, cambiare <span style="font-family:Georgia">carattere</span> e <span style="font-size:14pt">dimensione</span>.</p>
<h2>Cosa puoi fare</h2>
<ul><li>Aprire e salvare file Word (.docx)</li><li>Titoli, elenchi puntati e numerati, rientri e interlinea</li><li>Tabelle, immagini, collegamenti, simboli e interruzioni di pagina</li><li>Intestazione e piè di pagina con numero di pagina</li></ul>
<h2>Esempio di tabella</h2>
<table><tbody><tr><td style="background-color:#dcebe2"><b>Voce</b></td><td style="background-color:#dcebe2"><b>Quantità</b></td><td style="background-color:#dcebe2"><b>Note</b></td></tr><tr><td>Fogli A4</td><td>500</td><td>Risma da ordinare</td></tr><tr><td>Toner</td><td>2</td><td>Nero</td></tr></tbody></table>
<ol><li>Seleziona il testo</li><li>Scegli la formattazione dalla scheda Home</li><li>Salva con «Salva .docx»</li></ol>
<blockquote>Le scorciatoie da tastiera sono quelle di sempre: Ctrl+B, Ctrl+I, Ctrl+U, Ctrl+Z, Ctrl+S, Ctrl+F.</blockquote>
<p style="text-align:right"><i>Fine del documento di esempio</i></p>`;
(function init(){let d=null,th='';try{d=JSON.parse(localStorage.getItem('scrittoio.draft')||'null');th=localStorage.getItem('scrittoio.theme')||'';}catch(e){}
  if(th)document.documentElement.dataset.theme=th;
  try{$('#bAuthor').textContent='Autore: '+(ME()||'(da scegliere)');}catch(e){}
  if(d&&d.html){Object.assign(st,d.st||{});st.comments=st.comments||{};applyStyles();applyPage();loadDoc(d.name||'Documento senza titolo',d.html,d.h,d.f);}
  else{applyStyles();applyPage();loadDoc('Relazione di esempio',SAMPLE,'','<p style="text-align:center">Pagina <span class="fld" data-f="page" contenteditable="false">#</span> di <span class="fld" data-f="total" contenteditable="false">##</span></p>');}
  dirty=false;$('#saveState').textContent=d?'Bozza ripresa da questo browser':'Documento di esempio';
  if($('#desk').clientWidth<pageDims().w*MM+40)zoomFit();
  ed.blur();})();
})();
</script>

