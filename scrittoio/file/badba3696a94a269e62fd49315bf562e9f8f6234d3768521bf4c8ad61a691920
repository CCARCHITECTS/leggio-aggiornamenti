function shade(hexc,k){const h=(hexc||'#2f6b4f').replace('#','');const n=[0,2,4].map(i=>parseInt(h.substr(i,2),16));return '#'+n.map(v=>Math.round(k>0?v+(255-v)*k:v*(1+k)).toString(16).padStart(2,'0')).join('');}
