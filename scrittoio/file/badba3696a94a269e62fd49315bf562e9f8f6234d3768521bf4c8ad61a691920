function wrapTxt(t,max){const w=String(t).split(/\s+/);const L=[];let c='';w.forEach(x=>{if((c+' '+x).trim().length>max&&c){L.push(c);c=x;}else c=(c+' '+x).trim();});if(c)L.push(c);return L.slice(0,4);}
