      if(k==null||k<=prevK||k>=nextK){k=nextK===Infinity?prevK+1024:(prevK+nextK)/2;if(nextK-prevK<1e-6)renum=true;CLOUD.keys[id]=k;CLOUD.dk[id]=1;}prevK=k;}
