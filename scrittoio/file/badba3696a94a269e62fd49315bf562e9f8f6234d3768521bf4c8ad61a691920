    const m=cloudMeta();if(m!==CLOUD.metaSent||Date.now()-CLOUD.metaT>60000){const prev=CLOUD.metaSent;CLOUD.metaSent=m;CLOUD.metaT=Date.now();const M=JSON.parse(m);try{await CLOUD.db.doc('docs/'+docId).update({name:M.name,h:M.h,f:M.f,c:M.c,p:M.p,t:Date.now(),by:CLOUD.me||''});}catch(e){CLOUD.metaSent=prev;cloudErr(e);}}
