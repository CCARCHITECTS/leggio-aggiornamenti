    case 'cycle':{const cx=W/2,cy=H/2,R=Math.min(W,H)/2-42,r=Math.min(44,R*0.55);top.forEach((it,i)=>{const a=-Math.PI/2+i*2*Math.PI/top.length,x=cx+R*Math.cos(a),y=cy+R*Math.sin(a);const a2=a+Math.PI/top.length;
