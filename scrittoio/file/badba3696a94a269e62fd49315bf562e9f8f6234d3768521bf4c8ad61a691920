<script>
(function(){
"use strict";
const $=s=>document.querySelector(s), $$=s=>Array.from(document.querySelectorAll(s));
const ed=$('#editor'), paper=$('#paper'), hdr=$('#hdr'), ftr=$('#ftr');
const MM=96/25.4; // px per mm
const PAGES={A4:[210,297],A5:[148,210],A3:[297,420],Letter:[215.9,279.4],Legal:[215.9,355.6]};
const st={page:'A4',orient:'p',margin:{t:25,b:25,l:25,r:25},zoom:1,guides:true,pw:210,ph:297,cols:1,wm:'',pageColor:'',styles:null,comments:{}};
let lastRange=null, painterFmt=null, selImg=null, dirty=false;

try{document.execCommand('defaultParagraphSeparator',false,'p');}catch(e){}

/* ---------- avvisi ---------- */
let toastT;
function toast(msg){let t=$('.toast');if(!t){t=document.createElement('div');t.className='toast';document.body.appendChild(t);}
  t.textContent=msg;t.hidden=false;clearTimeout(toastT);toastT=setTimeout(()=>t.hidden=true,3200);}

/* ---------- finestre ---------- */
function modal(title,bodyNode,buttons){
  return new Promise(res=>{
    const back=document.createElement('div');back.className='modalBack';
    const m=document.createElement('div');m.className='modal';m.setAttribute('role','dialog');
    const h=document.createElement('h3');h.textContent=title;m.appendChild(h);
    const b=document.createElement('div');b.className='body';b.appendChild(bodyNode);m.appendChild(b);
    const f=document.createElement('div');f.className='foot';
    const close=v=>{back.remove();res(v);};
    (buttons||[{t:'Chiudi',v:null}]).forEach(x=>{const bt=document.createElement('button');bt.className='btn'+(x.primary?' primary':'');bt.textContent=x.t;bt.onclick=()=>close(x.v);f.appendChild(bt);});
    m.appendChild(f);back.appendChild(m);document.body.appendChild(back);
    back.addEventListener('mousedown',e=>{if(e.target===back)close(null);});
    back.addEventListener('keydown',e=>{if(e.key==='Escape')close(null);if(e.key==='Enter'&&e.target.tagName==='INPUT'){const p=(buttons||[]).find(x=>x.primary);if(p){e.preventDefault();close(p.v);}}});
    const fi=m.querySelector('textarea,input,select,button');if(fi)setTimeout(()=>fi.focus(),20);
  });
}
function el(tag,attrs,kids){const e=document.createElement(tag);if(attrs)for(const k in attrs){const v=attrs[k];if(k==='text')e.textContent=v;else if(k==='html')e.innerHTML=v;else if(typeof v==='function')e[k]=v;else if(k==='value')e.value=v;else e.setAttribute(k,v);}
  (kids||[]).forEach(k=>e.appendChild(typeof k==='string'?document.createTextNode(k):k));return e;}

/* ---------- selezione ---------- */
function inEditor(n){return n&&(ed.contains(n)||hdr.contains(n)||ftr.contains(n));}
document.addEventListener('selectionchange',()=>{const s=getSelection();if(s.rangeCount&&inEditor(s.anchorNode)&&document.activeElement&&inEditor(document.activeElement)){lastRange=s.getRangeAt(0).cloneRange();updateUI();}});
function restoreSel(){const cur=getSelection();if(cur.rangeCount&&inEditor(cur.anchorNode))lastRange=cur.getRangeAt(0).cloneRange();if(!lastRange)return;const keep=lastRange.cloneRange();const s=getSelection();
  const root=hdr.contains(keep.startContainer)?hdr:ftr.contains(keep.startContainer)?ftr:ed;
  if(document.activeElement!==root)root.focus({preventScroll:true});s.removeAllRanges();s.addRange(keep.cloneRange());lastRange=keep;}
function activeRoot(){if(lastRange){if(hdr.contains(lastRange.startContainer))return hdr;if(ftr.contains(lastRange.startContainer))return ftr;}return ed;}
// i pulsanti non rubano la selezione
$$('.ribbon button, .ribbon .colorBtn').forEach(b=>b.addEventListener('mousedown',e=>{if(e.target.tagName!=='INPUT')e.preventDefault();}));

/* ================= vista a pagine separate (come il layout di stampa) ================= */
const GAP=18;let pageView=true,viewPages=1,layT=null;
const sheets=document.createElement('div');sheets.id='sheets';paper.insertBefore(sheets,paper.firstChild);
function cleanHTML(root){const c=(root||ed).cloneNode(true);c.querySelectorAll('.pgSp').forEach(x=>x.remove());return c.innerHTML;}
function stripSpacers(){ed.querySelectorAll('.pgSp').forEach(x=>{const p=x.parentNode;x.remove();if(p&&x.tagName==='SPAN')p.normalize();});}
function textLines(c){const r=document.createRange();r.selectNodeContents(c);const er=ed.getBoundingClientRect(),k=ed.offsetHeight/(er.height||1)||1;const L=[];
  Array.from(r.getClientRects()).forEach(x=>{if(!x.height)return;const t=(x.top-er.top)*k,b=(x.bottom-er.top)*k;const l=L.find(z=>t<z.b-2&&b>z.t+2);if(l){l.t=Math.min(l.t,t);l.b=Math.max(l.b,b);}else L.push({t,b});});return L.sort((a,b)=>a.t-b.t);}
function charTops(c){const map=[];const w=document.createTreeWalker(c,NodeFilter.SHOW_TEXT);let n,tot=0;while((n=w.nextNode())){if(n.parentElement.closest('.pgSp'))continue;map.push([n,tot]);tot+=n.data.length;}
  const er=ed.getBoundingClientRect(),k=ed.offsetHeight/(er.height||1)||1;const at=i=>{for(let j=map.length-1;j>=0;j--)if(i>=map[j][1]){const [nd,o]=map[j];const off=i-o;if(off>=nd.data.length)return null;const r=document.createRange();r.setStart(nd,off);r.setEnd(nd,off+1);const q=r.getClientRects()[0]||r.getBoundingClientRect();return {nd,off,t:(q.top-er.top)*k};}return null;};return {tot,at};}
function splitBlock(c,limit,nextStart){const L=textLines(c);if(L.length<2)return false;let k=L.findIndex(l=>l.b>limit+0.5);if(k<=0)return false;
  if(k<2&&L.length>2)return false;if(L.length-k<2&&k>2)k=L.length-2;if(k<1)return false;const lineT=L[k].t;
  const ct=charTops(c);let lo=0,hi=ct.tot-1,pos=-1;while(lo<=hi){const mid=(lo+hi)>>1;const a=ct.at(mid);if(!a){hi=mid-1;continue;}if(a.t>=lineT-1.5){pos=mid;hi=mid-1;}else lo=mid+1;}
  if(pos<=0)return false;const a=ct.at(pos);if(!a)return false;const sp=document.createElement('span');sp.className='pgSp';sp.contentEditable='false';sp.setAttribute('aria-hidden','true');
  sp.style.cssText='display:inline-block;width:100%;vertical-align:top;height:'+Math.max(1,nextStart-lineT)+'px';const r=document.createRange();r.setStart(a.nd,a.off);r.collapse(true);r.insertNode(sp);
  const b=ct.at(pos);if(b){const diff=nextStart-b.t;if(Math.abs(diff)>0.5)sp.style.height=Math.max(1,parseFloat(sp.style.height)+diff)+'px';}return true;}
function detachSpacers(){const a=Array.from(ed.querySelectorAll('.pgSp')).map(x=>[x,x.parentNode,x.nextSibling]);a.forEach(([x])=>x.remove());return a;}
function reattachSpacers(a){for(let i=a.length-1;i>=0;i--){const [x,p,n]=a[i];try{if(p&&p.isConnected&&(!n||n.parentNode===p))p.insertBefore(x,n);}catch(e){}}}
function schedLayout(ms){clearTimeout(layT);layT=setTimeout(layoutPages,ms==null?60:ms);}
function yIn(n){const er=ed.getBoundingClientRect();const k=ed.offsetHeight/(er.height||1)||1;return (n.getBoundingClientRect().top-er.top)*k;}
function hIn(n){const er=ed.getBoundingClientRect();const k=ed.offsetHeight/(er.height||1)||1;return n.getBoundingClientRect().height*k;}
function mkSpacer(tag,h,cols){let s;if(tag==='TR'){s=document.createElement('tr');const td=document.createElement('td');td.colSpan=cols||1;td.style.cssText='height:'+h+'px;padding:0;border:0;background:transparent';s.appendChild(td);}
  else{s=document.createElement(tag==='LI'?'li':'div');s.style.height=h+'px';}s.className='pgSp';s.contentEditable='false';s.setAttribute('aria-hidden','true');return s;}
function layoutPages(){
  const on=pageView&&!(st.cols>1)&&!$('#zoomBox').hidden;
