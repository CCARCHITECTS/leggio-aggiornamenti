const BLOCKS='P,H1,H2,H3,H4,H5,H6,LI,BLOCKQUOTE,PRE,DIV,TD,TH';
function selBlocks(){const s=getSelection();if(!s.rangeCount)return[];const r=s.getRangeAt(0);const root=activeRoot();const out=[];
  root.querySelectorAll(BLOCKS.toLowerCase()).forEach(b=>{if(b.classList.contains('pb'))return;if(b.querySelector(BLOCKS.toLowerCase().replace(/td,th/,'').replace(/,$/,'')))return;if(r.intersectsNode(b))out.push(b);});
  if(!out.length){let n=r.startContainer;while(n&&n!==root){if(n.nodeType===1&&BLOCKS.split(',').includes(n.tagName)){out.push(n);break;}n=n.parentNode;}
    if(!out.length&&root===ed){document.execCommand('formatBlock',false,'P');return selBlocks();}}
  return out;}

function currentCell(){let n=lastRange&&lastRange.startContainer;while(n&&n!==ed){if(n.nodeType===1&&(n.tagName==='TD'||n.tagName==='TH'))return n;n=n.parentNode;}return null;}

