  if(!r)return;recMacro={name:name.value.trim()||'Macro',key:key.value,steps:[]};const sm=$('#stMacro');if(sm){sm.hidden=false;sm.textContent='● Registrazione macro: clicca per fermare';sm.style.cursor='pointer';sm.onclick=macroStop;}ed.focus();}
