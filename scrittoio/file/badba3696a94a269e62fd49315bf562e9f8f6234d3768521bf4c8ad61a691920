async function cloudPush(){if(!CLOUD.doc)return;if(CLOUD.busy){CLOUD.again=true;return;}CLOUD.busy=true;const docId=CLOUD.doc;
  try{CLOUD.applying=true;cloudIds();cloudObs.takeRecords();CLOUD.applying=false;const L=topBlocks();const col=CLOUD.db.collection('docs/'+docId+'/blocks');
