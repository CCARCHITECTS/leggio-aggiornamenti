function exec(cmd,val){restoreSel();document.execCommand('styleWithCSS',false,true);document.execCommand(cmd,false,val);fixFonts();record();afterChange(true);updateUI();}
function fixFonts(){ // converte <font size> e <font color> in stili
  const made=[];[ed,hdr,ftr].forEach(root=>root.querySelectorAll('font').forEach(f=>{const s=document.createElement('span');
    if(f.size&&f.dataset.pt)s.style.fontSize=f.dataset.pt+'pt';
    if(f.color)s.style.color=f.color;if(f.face)s.style.fontFamily=f.face;s.style.cssText+=';'+(f.getAttribute('style')||'');
    while(f.firstChild)s.appendChild(f.firstChild);f.replaceWith(s);made.push(s);}));return made;}
function setFontSize(pt){restoreSel();const s=getSelection();if(!s.rangeCount)return;
  if(s.isCollapsed){toast('Seleziona il testo da ridimensionare');return;}
  document.execCommand('styleWithCSS',false,false);document.execCommand('fontSize',false,'7');
  const R=activeRoot();
  R.querySelectorAll('font[size="7"] [style*="font-size"]').forEach(x=>x.style.fontSize='');
  R.querySelectorAll('font[size="7"]').forEach(f=>{f.dataset.pt=pt;});
  const big=[...R.querySelectorAll('[style*="xxx-large"]')];big.forEach(x=>{x.querySelectorAll('[style*="font-size"]').forEach(y=>y.style.fontSize='');x.style.fontSize=pt+'pt';});
