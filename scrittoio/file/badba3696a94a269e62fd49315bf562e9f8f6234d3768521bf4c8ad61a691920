function tablePicker(){const pop=document.createElement('div');pop.className='pop';const g=document.createElement('div');g.className='tblGrid';const lab=el('div',{text:'Inserisci tabella',style:'margin-bottom:6px;font-size:12px;color:var(--muted)'});
  for(let r=1;r<=8;r++)for(let c=1;c<=8;c++){const d=document.createElement('div');d.dataset.r=r;d.dataset.c=c;g.appendChild(d);}
  g.addEventListener('mouseover',e=>{const t=e.target;if(!t.dataset.r)return;g.childNodes.forEach(d=>d.classList.toggle('hl',+d.dataset.r<=+t.dataset.r&&+d.dataset.c<=+t.dataset.c));lab.textContent=t.dataset.c+' × '+t.dataset.r;});
  g.addEventListener('click',e=>{const t=e.target;if(!t.dataset.r)return;pop.remove();makeTable(+t.dataset.r,+t.dataset.c);});
  pop.append(lab,g);const b=$('[data-act="table"]').getBoundingClientRect();pop.style.left=Math.min(b.left,innerWidth-230)+'px';pop.style.top=(b.bottom+4)+'px';document.body.appendChild(pop);
  setTimeout(()=>document.addEventListener('mousedown',function h(e){if(!pop.contains(e.target)){pop.remove();document.removeEventListener('mousedown',h);}}),0);}
function makeTable(r,c){let h='<table><tbody>';for(let i=0;i<r;i++){h+='<tr>';for(let j=0;j<c;j++)h+='<td><br></td>';h+='</tr>';}h+='</tbody></table><p><br></p>';insertHTML(h);}
function tblOp(op){const cell=currentCell();if(!cell){toast('Metti il cursore dentro una cella della tabella');return;}
  const tr=cell.parentNode,table=cell.closest('table'),ci=Array.prototype.indexOf.call(tr.children,cell);
  if(op==='rowAbove'||op==='rowBelow'){const n=tr.cloneNode(true);n.querySelectorAll('td,th').forEach(x=>x.innerHTML='<br>');tr.parentNode.insertBefore(n,op==='rowAbove'?tr:tr.nextSibling);}
  else if(op==='delRow'){if(table.rows.length<=1)table.remove();else tr.remove();}
  else if(op==='colLeft'||op==='colRight'){Array.from(table.rows).forEach(row=>{const ref=row.children[ci];const n=document.createElement(ref?ref.tagName:'td');n.innerHTML='<br>';if(!ref)row.appendChild(n);else row.insertBefore(n,op==='colLeft'?ref:ref.nextSibling);});}
  else if(op==='delCol'){Array.from(table.rows).forEach(row=>{row.children[ci]&&row.children[ci].remove();});if(!table.rows[0].children.length)table.remove();}
