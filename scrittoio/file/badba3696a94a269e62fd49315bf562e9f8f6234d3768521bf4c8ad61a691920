    case 'blocks':{const cols=Math.min(3,top.length),rows=Math.ceil(top.length/cols),bw=(W-10*(cols-1))/cols,bh=(H-10*(rows-1))/rows;top.forEach((it,i)=>{const x=(i%cols)*(bw+10),y=Math.floor(i/cols)*(bh+10);s+='<rect x="'+x+'" y="'+y+'" width="'+bw+'" height="'+bh+'" rx="6" fill="'+shade(C,(i%4)*0.12)+'"/>'+txtBlock(x+bw/2,y+bh/2,it.t,Math.max(8,bw/8),13,'#fff');});break;}
