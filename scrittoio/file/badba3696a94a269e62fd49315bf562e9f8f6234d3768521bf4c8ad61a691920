  const r=document.createRange();if(last){r.setStart(last,last.data.length);}else{r.selectNodeContents(b);r.collapse(false);}const s=getSelection();s.removeAllRanges();s.addRange(r);lastRange=r.cloneRange();}
function insertByKey(n,o){const L=topBlocks();const after=L.find(b=>(CLOUD.keys[b.dataset.bid]??Infinity)>o&&b!==n);if(after)after.before(n);else{const last=L.filter(b=>b!==n).pop();if(last)last.after(n);else ed.appendChild(n);}}
function cloudApply(snap){const ch=snap.docChanges();if(!ch.length)return;CLOUD.applying=true;const car=caretSave();let changed=false;
  try{for(const c of ch){const id=c.doc.id;if(c.type==='removed'){const b=blockById(id);if(b&&blockHtml(b)===CLOUD.sent[id]){b.remove();changed=true;}delete CLOUD.sent[id];delete CLOUD.keys[id];continue;}
      if(c.doc.metadata&&c.doc.metadata.hasPendingWrites)continue;const d=c.doc.data()||{};if(typeof d.h!=='string')continue;const b=blockById(id);
      if(b){const cur=blockHtml(b);const moved=CLOUD.keys[id]!==d.o;CLOUD.keys[id]=d.o;if(cur===d.h){CLOUD.sent[id]=d.h;if(moved){insertByKey(b,d.o);changed=true;}continue;}if(cur!==CLOUD.sent[id])continue;// modificato anche qui: vince la versione locale, che parte tra poco
