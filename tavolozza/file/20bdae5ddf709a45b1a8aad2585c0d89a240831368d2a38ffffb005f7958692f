const Menus = {
  open: null,
  init() {
    const bar = $('#menubar');
    const logo = h('div', { class: 'logo' }); logo.innerHTML = icon('logo'); logo.append('Tavolozza');
    bar.append(logo);
    MENUS.forEach(([name, items]) => {
      const m = h('div', { class: 'mitem' }, name);
      m.addEventListener('pointerdown', e => { e.preventDefault(); if (this.open && this.open.btn === m) { this.close(); return; } this.show(m, items); });
      m.addEventListener('pointerenter', () => { if (this.open && this.open.btn !== m) this.show(m, items); });
      bar.append(m);
    });
    window.addEventListener('pointerdown', e => { if (this.open && !e.target.closest('.dropdown') && !e.target.closest('.mitem')) this.close(); });
  },
  show(btn, items) {
    this.close();
    const r = btn.getBoundingClientRect();
    btn.classList.add('open');
    const dd = this.build(typeof items === 'function' ? items() : items, r.left, r.bottom);
    this.open = { btn, dd, subs: [] };
  },
  build(items, x, y, isSub) {
    const dd = h('div', { class: 'dropdown' });
    for (const it of items) {
      if (it === '-') { dd.append(h('div', { class: 'sep' })); continue; }
      const dis = typeof it.dis === 'function' ? it.dis() : it.dis;
      const lab = typeof it.label === 'function' ? it.label() : it.label;
      const el = h('div', { class: 'di' + (dis ? ' dis' : '') + (it.sub ? ' sub' : '') + (it.chk && it.chk() ? ' chk' : '') }, lab, it.k ? h('span', { class: 'k' }, it.k) : null);
      if (it.sub && !dis) {
        el.addEventListener('pointerenter', () => {
          if (this.open) { this.open.subs.forEach(s => s.remove()); this.open.subs = []; }
          const r = el.getBoundingClientRect();
          const sd = this.build(typeof it.sub === 'function' ? it.sub() : it.sub, r.right - 2, r.top - 4, true);
          if (this.open) this.open.subs.push(sd);
        });
      } else if (!it.sub) {
        el.addEventListener('pointerenter', () => { if (this.open && !isSub) { this.open.subs.forEach(s => s.remove()); this.open.subs = []; } });
        el.addEventListener('click', () => { if (dis) return; this.close(); setTimeout(() => it.fn && it.fn(), 0); });
      }
      dd.append(el);
    }
    dd.style.left = x + 'px'; dd.style.top = y + 'px';
    document.body.append(dd);
    const r = dd.getBoundingClientRect();
    if (r.bottom > innerHeight) dd.style.top = Math.max(0, innerHeight - r.height - 4) + 'px';
    if (r.right > innerWidth) dd.style.left = Math.max(0, (isSub ? x - r.width - 230 : innerWidth - r.width - 4)) + 'px';
    return dd;
  },
  popup(items, x, y, above) {
    this.close();
    const dd = this.build(items, x, y);
    if (above) dd.style.top = Math.max(0, y - dd.getBoundingClientRect().height) + 'px';
    this.open = { btn: { classList: { remove() { } } }, dd, subs: [] };
  },
  close() { if (!this.open) return; this.open.btn.classList.remove('open'); this.open.dd.remove(); this.open.subs.forEach(s => s.remove()); this.open = null; },
};

