<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tavolozza Studio</title>
<style>
:root{color-scheme:dark;
  --bg0:#1b1c1f; --bg1:#232428; --bg2:#2b2d32; --bg3:#34363c; --bg4:#40434a;
  --line:#141518; --line2:#3a3d44; --tx:#d9dbe0; --tx2:#9a9ea8; --tx3:#6c707a;
  --acc:#2fb5a5; --acc2:#238f83; --accbg:rgba(47,181,165,.18); --warn:#e0a040; --err:#e06060;
  --font: "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;overflow:hidden;background:var(--bg0);color:var(--tx);font:12px/1.35 var(--font);user-select:none;-webkit-user-select:none}
input,select,button,textarea{font:inherit;color:inherit}
button{cursor:pointer}
#app{display:grid;height:100vh;grid-template-rows:28px 38px 1fr 22px;grid-template-columns:44px 1fr auto;grid-template-areas:"menu menu menu" "opts opts opts" "tools center panels" "status status status"}
/* menu */
#menubar{grid-area:menu;display:flex;align-items:stretch;background:var(--bg1);border-bottom:1px solid var(--line);padding-left:6px}
#menubar .logo{display:flex;align-items:center;gap:6px;padding:0 10px 0 4px;font-weight:600;color:var(--acc)}
#menubar .logo svg{width:16px;height:16px}
.mitem{padding:0 10px;display:flex;align-items:center;cursor:default;border-radius:3px;margin:3px 0}
.mitem:hover,.mitem.open{background:var(--bg3)}
.dropdown{position:fixed;z-index:1000;background:var(--bg2);border:1px solid var(--line);box-shadow:0 8px 24px rgba(0,0,0,.5);padding:4px 0;min-width:230px;border-radius:4px}
.dropdown .di{display:flex;align-items:center;padding:5px 14px 5px 26px;white-space:nowrap;cursor:default;position:relative}
.dropdown .di:hover:not(.dis){background:var(--acc2);color:#fff}
.dropdown .di .k{margin-left:auto;padding-left:28px;color:var(--tx2);font-size:11px}
.dropdown .di:hover .k{color:#e8fffb}
.dropdown .di.dis{color:var(--tx3)}
.dropdown .di.chk::before{content:"✓";position:absolute;left:9px}
.dropdown .di.sub::after{content:"▸";margin-left:auto;padding-left:20px;color:var(--tx2)}
.dropdown .sep{height:1px;background:var(--line2);margin:4px 0}
/* options */
#optbar{grid-area:opts;display:flex;align-items:center;gap:10px;background:var(--bg2);border-bottom:1px solid var(--line);padding:0 10px;overflow-x:auto;overflow-y:hidden;white-space:nowrap}
#optbar::-webkit-scrollbar{height:4px}
#optbar .toolname{display:flex;align-items:center;gap:6px;padding-right:10px;border-right:1px solid var(--line2);color:var(--tx2)}
#optbar .toolname svg{width:18px;height:18px}
#optbar label{display:flex;align-items:center;gap:5px;color:var(--tx2)}
#optbar .grp{display:flex;align-items:center;gap:6px;padding-right:10px;border-right:1px solid var(--line2)}
#optbar .grp:last-child{border-right:0}
input[type=number],input[type=text],select{background:var(--bg0);border:1px solid var(--line2);border-radius:3px;padding:2px 5px;height:22px;color:var(--tx)}
input[type=number]{width:58px}
input[type=range]{width:100px;accent-color:var(--acc);height:16px}
input[type=checkbox]{accent-color:var(--acc)}
select{padding:1px 4px}
.btn{background:var(--bg3);border:1px solid var(--line2);border-radius:3px;padding:3px 10px;height:24px;display:inline-flex;align-items:center;gap:5px}
.btn:hover{background:var(--bg4)}
.btn.pri{background:var(--acc2);border-color:var(--acc);color:#fff}
.btn.pri:hover{background:var(--acc)}
.btn.on{background:var(--accbg);border-color:var(--acc)}
.seg{display:inline-flex;border:1px solid var(--line2);border-radius:3px;overflow:hidden}
.seg button{background:var(--bg3);border:0;border-right:1px solid var(--line2);height:22px;min-width:26px;padding:0 6px;display:flex;align-items:center;justify-content:center}
.seg button:last-child{border-right:0}
.seg button.on{background:var(--acc2);color:#fff}
.seg svg{width:15px;height:15px}
.swatch{width:22px;height:22px;border:1px solid var(--line2);border-radius:3px;cursor:pointer;background-image:linear-gradient(45deg,#888 25%,transparent 25%),linear-gradient(-45deg,#888 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#888 75%),linear-gradient(-45deg,transparent 75%,#888 75%);background-size:8px 8px;background-position:0 0,0 4px,4px -4px,-4px 0;position:relative}
.swatch i{position:absolute;inset:0;border-radius:2px}
/* toolbar */
#toolbar{grid-area:tools;background:var(--bg2);border-right:1px solid var(--line);display:flex;flex-direction:column;align-items:center;padding:6px 0;gap:1px;overflow-y:auto;overflow-x:hidden}
#toolbar::-webkit-scrollbar{width:0}
.tbtn{width:34px;height:30px;border:0;background:transparent;border-radius:4px;display:flex;align-items:center;justify-content:center;color:var(--tx);position:relative;flex:none}
.tbtn:hover{background:var(--bg3)}
.tbtn.on{background:var(--acc2);color:#fff}
.tbtn svg{width:19px;height:19px}
.tbtn.more::after{content:"";position:absolute;right:3px;bottom:3px;border:3px solid transparent;border-right-color:currentColor;border-bottom-color:currentColor;opacity:.6}
.tsep{width:26px;height:1px;background:var(--line2);margin:4px 0;flex:none}
#colorwell{position:relative;width:38px;height:40px;margin-top:6px;flex:none}
#colorwell .fg,#colorwell .bgc{position:absolute;width:22px;height:22px;border:1px solid #000;box-shadow:0 0 0 1px #777;cursor:pointer}
#colorwell .fg{left:3px;top:3px;z-index:2}
#colorwell .bgc{left:13px;top:14px}
#colorwell .sw{position:absolute;right:-2px;top:-2px;width:13px;height:13px;cursor:pointer;color:var(--tx2)}
#colorwell .df{position:absolute;left:0;bottom:-3px;width:12px;height:12px;cursor:pointer}
/* center */
#center{grid-area:center;display:flex;flex-direction:column;min-width:0;min-height:0;background:var(--bg0)}
#tabs{display:flex;background:var(--bg1);border-bottom:1px solid var(--line);height:28px;flex:none;overflow-x:auto;overflow-y:hidden}
#tabs::-webkit-scrollbar{height:3px}
.tab{display:flex;align-items:center;gap:8px;padding:0 8px 0 12px;border-right:1px solid var(--line);color:var(--tx2);cursor:default;white-space:nowrap;max-width:260px}
.tab.on{background:var(--bg3);color:var(--tx);box-shadow:inset 0 2px 0 var(--acc)}
.tab span{overflow:hidden;text-overflow:ellipsis}
.tab .x{width:16px;height:16px;border-radius:3px;display:flex;align-items:center;justify-content:center;color:var(--tx3)}
.tab .x:hover{background:var(--bg4);color:var(--tx)}
#viewwrap{flex:1;position:relative;min-height:0;display:grid;grid-template-columns:18px 1fr;grid-template-rows:18px 1fr}
#rulerCorner{background:var(--bg2);border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
#rulerTop,#rulerLeft{background:var(--bg2);display:block;width:100%;height:100%}
#viewport{position:relative;overflow:hidden;min-width:0;min-height:0}
#viewport canvas#view{position:absolute;inset:0;width:100%;height:100%;touch-action:none}
#viewwrap.norulers{grid-template-columns:0 1fr;grid-template-rows:0 1fr}
#empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px;color:var(--tx2);pointer-events:none}
#empty .card{pointer-events:auto;background:var(--bg2);border:1px solid var(--line2);border-radius:8px;padding:26px 30px;text-align:center;max-width:440px}
#empty h2{margin:0 0 6px;color:var(--tx);font-weight:600;font-size:18px}
#empty .row{display:flex;gap:10px;justify-content:center;margin-top:16px;flex-wrap:wrap}
#textEditor{position:absolute;z-index:5;background:transparent;border:1px dashed var(--acc);outline:none;resize:none;overflow:hidden;white-space:pre;padding:0;margin:0;min-width:20px;caret-color:var(--acc)}
/* panels */
#panels{grid-area:panels;width:290px;background:var(--bg1);border-left:1px solid var(--line);display:flex;flex-direction:column;min-height:0;overflow:hidden}
.pgroup{display:flex;flex-direction:column;border-bottom:1px solid var(--line);min-height:0}
.pgroup.grow{flex:1}
.ptabs{display:flex;background:var(--bg1);height:26px;flex:none;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:thin}
.ptab{padding:0 9px;white-space:nowrap;flex:none;display:flex;align-items:center;color:var(--tx2);cursor:default;border-right:1px solid var(--line)}
.ptab.on{background:var(--bg2);color:var(--tx)}
.ptabs .coll{margin-left:auto;width:26px;display:flex;align-items:center;justify-content:center;color:var(--tx3);cursor:pointer}
.pbody{background:var(--bg2);overflow:auto;min-height:0}
.pgroup.collapsed .pbody{display:none}
.pbody::-webkit-scrollbar{width:8px}.pbody::-webkit-scrollbar-thumb{background:var(--bg4);border-radius:4px}
/* color panel */
.cpanel{padding:8px;display:flex;flex-direction:column;gap:6px}
.cpick{display:flex;gap:6px}
.cpick canvas{border:1px solid var(--line);border-radius:2px;cursor:crosshair;touch-action:none}
.crow{display:flex;align-items:center;gap:6px}
.crow input[type=range]{flex:1}
.crow .lab{width:12px;color:var(--tx2)}
.crow input[type=number]{width:48px}
.swatches{display:flex;flex-wrap:wrap;gap:3px;padding:8px}
.swatches div{width:18px;height:18px;border:1px solid var(--line);cursor:pointer;border-radius:2px}
.swatches div:hover{outline:1px solid #fff}
/* layers */
.lhead{padding:6px 8px;display:flex;flex-direction:column;gap:5px;border-bottom:1px solid var(--line);flex:none;background:var(--bg2)}
.lhead .r{display:flex;align-items:center;gap:6px}
.lhead select{flex:1}
.lhead .lk{display:flex;gap:2px}
.ibtn{width:24px;height:22px;border:0;border-radius:3px;background:transparent;color:var(--tx2);display:inline-flex;align-items:center;justify-content:center;padding:0}
.ibtn:hover{background:var(--bg4);color:var(--tx)}
.ibtn.on{color:var(--acc);background:var(--accbg)}
.ibtn svg{width:15px;height:15px}
#layerList{flex:1;overflow-y:auto;background:var(--bg2);min-height:60px}
.lrow{display:flex;align-items:center;height:40px;border-bottom:1px solid var(--line);cursor:default;position:relative}
.lrow.on{background:#3a4a4a}
.lrow.drop-above{box-shadow:inset 0 2px 0 var(--acc)}
.lrow.drop-below{box-shadow:inset 0 -2px 0 var(--acc)}
.lrow.drop-into{outline:2px solid var(--acc);outline-offset:-2px}
.lrow .eye{width:28px;display:flex;justify-content:center;color:var(--tx2);flex:none;align-self:stretch;align-items:center;border-right:1px solid var(--line)}
.lrow .eye svg{width:15px;height:15px}
.lrow .eye.off svg{opacity:.15}
.lrow .tw{width:14px;flex:none;color:var(--tx2);text-align:center}
.lrow .clipm{width:12px;color:var(--tx2);flex:none;font-size:11px}
.lthumb{width:32px;height:32px;flex:none;border:1px solid #111;margin:0 3px;background:#fff;display:flex;align-items:center;justify-content:center;position:relative}
.lthumb canvas{max-width:30px;max-height:30px;display:block}
.lthumb.sel{outline:1px solid #fff;outline-offset:1px}
.lthumb.disabled::after{content:"";position:absolute;inset:0;background:linear-gradient(45deg,transparent 46%,#e04040 46%,#e04040 54%,transparent 54%),linear-gradient(-45deg,transparent 46%,#e04040 46%,#e04040 54%,transparent 54%)}
.lthumb svg{width:20px;height:20px;color:#444}
.lname{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 6px}
.lname input{width:100%;height:20px}
.lbad{color:var(--tx2);padding-right:6px;font-size:11px;display:flex;gap:4px;align-items:center}
.lbad svg{width:12px;height:12px}
.lfoot{display:flex;justify-content:flex-end;gap:2px;padding:3px 6px;background:var(--bg1);flex:none;border-top:1px solid var(--line)}
/* history */
.hrow{display:flex;align-items:center;gap:8px;padding:5px 10px;border-bottom:1px solid var(--line);cursor:default}
.hrow.on{background:#3a4a4a}
.hrow.future{color:var(--tx3)}
.hrow svg{width:13px;height:13px;color:var(--tx2)}
/* props */
.props{padding:10px;display:flex;flex-direction:column;gap:8px}
.props h4{margin:0;font-size:12px;color:var(--tx2);font-weight:600;text-transform:uppercase;letter-spacing:.04em}
.ctl{display:flex;flex-direction:column;gap:2px}
.ctl .t{display:flex;justify-content:space-between;color:var(--tx2)}
.ctl .t input{width:54px;height:19px;text-align:right}
.ctl input[type=range]{width:100%}
.adjgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;padding:8px}
.adjgrid button{height:34px;background:var(--bg3);border:1px solid var(--line2);border-radius:3px;display:flex;align-items:center;justify-content:center;color:var(--tx)}
.adjgrid button:hover{background:var(--bg4);border-color:var(--acc)}
.adjgrid svg{width:18px;height:18px}
.navbox{padding:8px;display:flex;flex-direction:column;gap:6px;align-items:center}
.navbox canvas{background:#111;cursor:pointer;max-width:100%}
.info{padding:8px 10px;display:grid;grid-template-columns:auto 1fr auto 1fr;gap:3px 8px;font-variant-numeric:tabular-nums}
.info b{color:var(--tx2);font-weight:normal}
/* status */
#status{grid-area:status;background:var(--bg1);border-top:1px solid var(--line);display:flex;align-items:center;gap:16px;padding:0 10px;color:var(--tx2);white-space:nowrap;overflow:hidden}
#status input{width:60px;height:17px;font-size:11px;padding:0 4px}
#status .msg{color:var(--tx)}
/* dialogs */
.modalbg{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:900;display:flex;align-items:center;justify-content:center}
.modalbg.light{background:transparent;pointer-events:none}
.modalbg.light .dlg{pointer-events:auto}
.dlg{background:var(--bg2);border:1px solid var(--line);border-radius:6px;box-shadow:0 14px 40px rgba(0,0,0,.6);min-width:320px;max-width:min(94vw,760px);max-height:92vh;display:flex;flex-direction:column}
.dlg .dh{padding:9px 14px;border-bottom:1px solid var(--line);font-weight:600;display:flex;align-items:center;cursor:move;background:var(--bg3);border-radius:6px 6px 0 0}
.dlg .dh .x{margin-left:auto;cursor:pointer;color:var(--tx2);padding:0 4px}
.dlg .db{padding:14px;overflow:auto;display:flex;flex-direction:column;gap:10px}
.dlg .df{padding:10px 14px;border-top:1px solid var(--line);display:flex;gap:8px;justify-content:flex-end;align-items:center}
.dlg .df .l{margin-right:auto;display:flex;align-items:center;gap:6px;color:var(--tx2)}
.frow{display:flex;align-items:center;gap:8px}
.frow > label:first-child{width:130px;color:var(--tx2)}
.frow input[type=text]{flex:1}
.toast{position:fixed;bottom:34px;left:50%;transform:translateX(-50%);background:var(--bg3);border:1px solid var(--acc);padding:8px 16px;border-radius:5px;z-index:2000;box-shadow:0 6px 20px rgba(0,0,0,.5);transition:opacity .3s}
.toast.err{border-color:var(--err)}
.styleside{display:flex;flex-direction:column;gap:2px;min-width:170px;border-right:1px solid var(--line2);padding-right:10px}
.styleside .si{display:flex;align-items:center;gap:6px;padding:5px 6px;border-radius:3px;cursor:default}
.styleside .si.on{background:var(--accbg)}
.kbd{display:grid;grid-template-columns:auto 1fr;gap:3px 18px;font-size:12px}
.kbd b{color:var(--acc);font-weight:600;white-space:nowrap}
.progress{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:3000;display:flex;align-items:center;justify-content:center;font-size:14px}
.progress div{background:var(--bg2);padding:16px 24px;border-radius:6px;border:1px solid var(--line2)}
.ctxmenu{position:fixed;z-index:1001}
@media (max-width:900px){#panels{width:230px}}
</style>
</head>
<body>
<div id="app">
  <div id="menubar"></div>
  <div id="optbar"></div>
  <div id="toolbar"></div>
  <div id="center">
    <div id="tabs"></div>
    <div id="viewwrap">
      <div id="rulerCorner"></div>
      <canvas id="rulerTop"></canvas>
      <canvas id="rulerLeft"></canvas>
      <div id="viewport">
        <canvas id="view"></canvas>
        <div id="empty"><div class="card">
          <h2>Tavolozza Studio</h2>
          <div>Editor di immagini con livelli. Apri un file PSD, PNG, JPG o WEBP, oppure crea un nuovo documento. Puoi anche trascinare i file qui.</div>
          <div class="row"><button class="btn pri" id="emptyNew">Nuovo documento</button><button class="btn" id="emptyOpen">Apri file…</button></div>
        </div></div>
      </div>
    </div>
  </div>
  <div id="panels"></div>
  <div id="status"></div>
</div>
<input type="file" id="fileInput" multiple accept=".psd,.psb,.tif,.tiff,.png,.jpg,.jpeg,.webp,.gif,.bmp,.svg,image/*" style="display:none">
<input type="file" id="placeInput" accept=".psd,.tif,.tiff,.png,.jpg,.jpeg,.webp,.gif,.bmp,.svg,image/*" style="display:none">
